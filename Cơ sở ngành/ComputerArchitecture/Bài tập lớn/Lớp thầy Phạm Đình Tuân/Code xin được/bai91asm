.data

Nhap: .asciiz " Nhap mot chuoi: "
Incd: .asciiz " Chieu dai cua chuoi: "
string: .word 100

.text

li $v0,4
la $a0,Nhap
syscall          #in ra Nhap

li $v0,8
la $a0,string
li $a1,100
syscall          #Nhap chuoi


li $t0,0
la $t1,string

Tinhcd:
lb $t2,($t1)     #luu tung ky tu cua chuoi vao $t2

sge $t3,$t2,32
sle $t4,$t2,126   #kiem tra chuoi 

bne $t3,$t4,In   # In ra chieu dai chuoi neu khong con ky tu

addi $t0,$t0,1
addi $t1,$t1,1   # tang $t0,$t1 khi chuoi con ky tu
j    Tinhcd  #vong lap

In:
li $v0,4
la $a0,Incd
syscall          #in ra Incd

li $v0,1
move $a0,$t0
syscall         #in ra chieu dai chuoi
