   "source": [
    "#Vi du ve chuyen doi co so sang he 10\n",
    "a = [1, 7, 0, 0, 3]\n",
    "b = 8\n",
    "k = len(a)  #hon k ly thuyet 1 don vi\n",
    "def tinh_n(a: list, b : int) -> int:\n",
    "    n = a[k - 1]\n",
    "    for i in range(k - 2, -1, -1):\n",
    "        n = b * n + a[i]\n",
    "    return n\n"
   ]
  },
