   "source": [
    "def f(n):\n",
    "    if n == 0:\n",
    "        return -1\n",
    "    if n == 1:\n",
    "        return 2\n",
    "    x = f(n-1)\n",
    "    for i in range(6):\n",
    "        x = x + f(n-2)\n",
    "    return x"
   ]
